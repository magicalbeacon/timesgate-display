# Copy to this NEW package's .env; do not overwrite the existing stock app's .env.
# Human screen numbers, left to right; this release only supports stock screens 1–2.
TARGET_SCREENS=1,2
TICKERS=AAPL,MSFT
DEVICE_IP=
DEVICE_ENDPOINT=post
LOCAL_TOKEN=
FINNHUB_API_KEY=
# No device writes until BOTH this flag and explicit CLI arm --apply.
DEVICE_WRITES_ENABLED=false
ROTATION_SECONDS=15
QUOTE_REFRESH_SECONDS=30
HISTORY_REFRESH_HOURS=6
STALE_QUOTE_SECONDS=180
PORT=8081

# Optional fixed Singapore demo weather: human screen5 only; no automatic setup.
WEATHER_ENABLED=false
# Set to this Pi's reachable LAN address and port8081, not Docker localhost.
SERVER_BASE_URL=

# Optional screen4 Pomodoro. Web buttons change timer state only; setup is manual.
POMODORO_ENABLED=false
# Uses the same SERVER_BASE_URL private Pi LAN origin above, on port8081.
